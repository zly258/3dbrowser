{
  "name": "@zhangly1403/3dbrowser",
  "private": false,
  "version": "1.7.1",
  "description": "A high-performance 3D model browser based on Three.js, supporting IFC, GLB, and more.",
  "keywords": [
    "threejs",
    "bim",
    "ifc",
    "3d-viewer",
    "browser"
  ],
  "license": "CC-BY-NC-4.0",
  "author": "zhangly1403@163.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zly258/3dbrowser.git"
  },
  "homepage": "https://zly258.github.io/3dbrowser/",
  "bugs": {
    "url": "https://github.com/zly258/3dbrowser/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/3dbrowser.umd.js",
  "module": "./dist/3dbrowser.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/3dbrowser.es.js",
      "require": "./dist/3dbrowser.umd.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && npx tsc -p tsconfig.lib.json --skipLibCheck && node scripts/post-build.js",
    "build:pages": "vite build --mode pages",
    "preview": "vite preview",
    "ui:audit": "node scripts/ui-audit.mjs",
    "ui:audit:strict": "node scripts/ui-audit.mjs --strict",
    "ui:coverage": "node scripts/class-coverage.cjs",
    "prepare": "husky",
    "commitlint": "commitlint --from=HEAD~1 --to=HEAD --verbose"
  },
  "dependencies": {
    "occt-import-js": "^0.0.23",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.181.2",
    "web-ifc": "^0.0.74"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "husky": "^9.1.7",
    "terser": "^5.46.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.1"
  }
}

{
  "name": "3dbrowser",
  "private": true,
  "version": "2.0.0",
  "description": "A high-performance 3D model browser based on Three.js, supporting IFC, GLB, and NBIM v11.",
  "keywords": [
    "threejs",
    "bim",
    "ifc",
    "3d-viewer",
    "nbim"
  ],
  "license": "CC-BY-NC-4.0",
  "author": "zhangly1403@qq.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zly258/3dbrowser.git"
  },
  "homepage": "https://zly258.github.io/3dbrowser/",
  "bugs": {
    "url": "https://github.com/zly258/3dbrowser/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npx tsc -p tsconfig.lib.json --skipLibCheck && node scripts/post-build.js",
    "build:pages": "vite build --mode pages",
    "preview": "vite preview",
    "ui:audit": "node scripts/ui-audit.mjs",
    "ui:audit:strict": "node scripts/ui-audit.mjs --strict",
    "ui:coverage": "node scripts/class-coverage.cjs",
    "test:nbim": "node scripts/run-nbim11-selftest.mjs",
    "migrate:nbim": "node scripts/run-nbim-legacy-to-v11.mjs",
    "verify:nbim-geom": "node scripts/run-nbim-geom-verify.mjs",
    "prepare": "husky",
    "commitlint": "commitlint --from=HEAD~1 --to=HEAD --verbose",
    "test:fixtures": "node scripts/nbim-fixture.mjs --check",
    "stats:nbim": "node scripts/nbim-stats.mjs",
    "convert:nbim": "node scripts/run-nbim-batch-convert.mjs",
    "unpublish:npm": "node scripts/npm-unpublish-history.mjs"
  },
  "dependencies": {
    "brotli-dec-wasm": "^2.3.2",
    "brotli-wasm": "^3.0.1",
    "occt-import-js": "^0.0.23",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.181.2",
    "web-ifc": "^0.0.74"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "husky": "^9.1.7",
    "terser": "^5.46.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.1"
  }
}

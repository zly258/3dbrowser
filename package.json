{
  "name": "3dbrowser",
  "private": true,
  "version": "2.0.0",
  "description": "A high-performance 3D model browser based on Three.js, supporting IFC, GLB, and NBIM v11.",
  "keywords": [
    "threejs",
    "bim",
    "ifc",
    "3d-viewer",
    "nbim"
  ],
  "license": "CC-BY-NC-4.0",
  "author": "zhangly1403@qq.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zly258/3dbrowser.git"
  },
  "homepage": "https://zly258.github.io/3dbrowser/",
  "bugs": {
    "url": "https://github.com/zly258/3dbrowser/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node node_modules/typescript/bin/tsc -p tsconfig.lib.json --skipLibCheck && node scripts/post-build.js",
    "build:pages": "vite build --mode pages",
    "preview": "vite preview",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.{js,mjs,cjs}\"",
    "check": "npm run typecheck && npm run lint && npm run test:nbim && node scripts/ui-audit.mjs --strict && node scripts/class-coverage.cjs",
    "ui:audit": "node scripts/ui-audit.mjs",
    "ui:audit:strict": "node scripts/ui-audit.mjs --strict",
    "ui:coverage": "node scripts/class-coverage.cjs",
    "test:nbim": "node scripts/run.mjs nbim11-selftest",
    "stats:nbim": "node scripts/nbim-stats.mjs"
  },
  "dependencies": {
    "brotli-dec-wasm": "^2.3.2",
    "brotli-wasm": "^3.0.1",
    "occt-import-js": "^0.0.23",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.181.2",
    "web-ifc": "^0.0.74"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "terser": "^5.46.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.1"
  }
}
